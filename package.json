{
  "name": "llm-explorer",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "postinstall": "node scripts/install-browsers.js",
    "prebuild:win": "node scripts/install-browsers.js",
    "build:win": "electron-builder --win"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "animejs": "^4.5.0",
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.firestarterpro.llm-explorer",
    "productName": "LLM Explorer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "scrapers.js",
      "providers.json",
      "templates.json",
      "vendor/**"
    ],
    "extraResources": [
      {
        "from": "pw-browsers",
        "to": "ms-playwright",
        "filter": [
          "chromium-*/**",
          "winldd-*/**"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LLM Explorer"
    }
  }
}
